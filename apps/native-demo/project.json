{
	"name": "native-demo",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/native-demo/src",
	"projectType": "application",
	"tags": ["scope:native"],
	"targets": {
		"install": {
			"command": "pnpm install",
			"options": { "cwd": "apps/native-demo" }
		},
		"ios": {
			"command": "ns debug ios",
			"options": { "cwd": "apps/native-demo" }
		},
		"android": {
			"command": "ns debug android",
			"options": { "cwd": "apps/native-demo" }
		},
		"lint": {
			"command": "eslint apps/native-demo/src"
		}
	}
}
